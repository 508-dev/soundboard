root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
# @Composable functions are conventionally PascalCase (they read as UI
# component declarations, per Compose's own API guidelines) — ktlint 1.0.1+
# understands this via the property below rather than flagging every screen.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.xml]
indent_size = 4
