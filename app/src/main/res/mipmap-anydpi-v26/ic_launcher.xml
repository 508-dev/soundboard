<?xml version="1.0" encoding="utf-8"?>
<!--
   Stays in `mipmap-anydpi-v26`, not `mipmap-anydpi`. Android lint raises
   ObsoleteSdkInt here because minSdk is already 26, but dropping the `-v26`
   makes AAPT fail to resolve @mipmap/ic_launcher at all. The lint warning is
   a false positive for adaptive icons; leave the qualifier alone.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!-- Themed icon (Android 13+): the launcher recolours this silhouette. -->
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
