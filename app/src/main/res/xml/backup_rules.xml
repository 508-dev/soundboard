<?xml version="1.0" encoding="utf-8"?>
<!--
   Pre-Android-12 backup rules.

   The board is excluded on purpose. It stores content:// URIs plus the
   persisted read grants that go with them, and those grants are scoped to this
   install on this device — restoring them elsewhere would produce a board of
   rows that all fail to play. Better to restore to an empty board.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/" />
</full-backup-content>
