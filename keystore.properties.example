# Copy to keystore.properties (gitignored) to sign local release builds.
# Generate a keystore once with:
#   keytool -genkeypair -v -keystore release.keystore -alias soundboard \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Keep release.keystore and its passwords out of git.
#
# This file is for signing a release build on a workstation. It is NOT how
# releases are published: CI signs with the same key, passed in from GitHub
# secrets as SOUNDBOARD_KEYSTORE_* environment variables, and never writes this
# file. See docs/deployment.md and docs/secrets.md.
#
# With neither this file nor those variables, a release build is simply
# unsigned — which is what f-droid.org's build server wants, since it signs its
# own binary with its own key.
storeFile=release.keystore
storePassword=
keyAlias=soundboard
keyPassword=
