# Copy to keystore.properties (gitignored) to sign local release builds.
# Generate a keystore once with:
#   keytool -genkeypair -v -keystore release.keystore -alias soundboard \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Keep release.keystore and its passwords out of git. For F-Droid, the
# metadata build server signs its own binary independently — this local
# signing config is only for side-loading or a GitHub Release APK.
storeFile=release.keystore
storePassword=
keyAlias=soundboard
keyPassword=
